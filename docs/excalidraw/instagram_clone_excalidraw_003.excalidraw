      "seed": 1983245439,
      "version": 899,
      "versionNonce": 893653713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794981619720,
      "created": 1794980976988,
      "link": null,
      "locked": false,
      "text": "user_username의 일부분을 검\n색했을 때 해당 유저를 찾아내\n야 함.\n\n한글자 칠 때 마다 LIKE를 통\n해서 비교해 계정을 찾음\n\n엔터를 입력해서 검색 한 경우에\n도 같은 기능\n\n\n해당 계정 클릭시 계정 프로필로\n갈 수 있음. (내 닉네임 검색x)",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "nSZoFQnDtLh-N2ZH-QIAR",
      "originalText": "user_username의 일부분을 검색했을 때 해당 유저를 찾아내야 함.\n\n한글자 칠 때 마다 LIKE를 통해서 비교해 계정을 찾음\n\n엔터를 입력해서 검색 한 경우에도 같은 기능\n\n\n해당 계정 클릭시 계정 프로필로 갈 수 있음. (내 닉네임 검색x)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
