    {
      "id": "kaKEp17UQds5yvYqr_n6O",
      "type": "text",
      "x": 3304.387913546756,
      "y": -261.0520516669413,
      "width": 415.24774169921875,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bVu",
      "roundness": null,
      "seed": 192797819,
      "version": 1300,
      "versionNonce": 1258517695,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794979864569,
      "created": 1794903914023,
      "link": null,
      "locked": false,
      "text": "뒤로가기 클릭 시: 타임라인 / 자신의 프로필\n\n사진은 10장까지 업로드 할 수 있으며, 순서를 드래그해서 지\n정할 수 있어야 함. 업로드시 사진의 순서에 따라 ID가 배정\n되어 사진의 순서를 ID순서로 찾음.\n\n사진은 자동으로 프론트엔드에서 1080x1080 사이즈로 자르\n거나 늘려서 업로드(사진 편집기능x, jpg, png, webp만 지원)\n\n캡션은 post_content varchar(2000)\n\n공유하기 버튼 누르면 홈피드로 새로고침",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "O_W1yMDjE2yYcestugijs",
      "originalText": "뒤로가기 클릭 시: 타임라인 / 자신의 프로필\n\n사진은 10장까지 업로드 할 수 있으며, 순서를 드래그해서 지정할 수 있어야 함. 업로드시 사진의 순서에 따라 ID가 배정되어 사진의 순서를 ID순서로 찾음.\n\n사진은 자동으로 프론트엔드에서 1080x1080 사이즈로 자르거나 늘려서 업로드(사진 편집기능x, jpg, png, webp만 지원)\n\n캡션은 post_content varchar(2000)\n\n공유하기 버튼 누르면 홈피드로 새로고침",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
