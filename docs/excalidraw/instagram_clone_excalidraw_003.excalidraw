    {
      "id": "sZCqJWgmq94YtveLFud9Y",
      "type": "text",
      "x": 2948.847444008751,
      "y": 553.858106557496,
      "width": 216.09588623046875,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
