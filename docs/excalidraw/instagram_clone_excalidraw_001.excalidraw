      "link": null,
      "locked": false,
      "text": "followee_id = \"user_id\"인 것\n들을 user_table에서 조건 or\nJOIN으로 써서 user_id,\nuser_username,\nuser_profile_url 을 가져옮\n (user_id는 해당 프로필로 이\n동하는데 사용)",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "FyJwc-_0KwJdoh4cXUnTV",
      "originalText": "followee_id = \"user_id\"인 것들을 user_table에서 조건 or JOIN으로 써서 user_id, user_username, user_profile_url 을 가져옮\n (user_id는 해당 프로필로 이동하는데 사용)",
      "autoResize": true,
