      "created": 1794485064485,
      "link": null,
      "locked": false,
      "text": "follower_id = \"user_id\"인 것\n들을 user_table에서 조건 or\nJOIN으로 써서 user_id,\nuser_username,\nuser_profile_url 을 가져옮\n (user_id는 해당 프로필로 이\n동하는데 사용)",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Ars_8Z-UyFjOFBb4EBUjr",
      "originalText": "follower_id = \"user_id\"인 것들을 user_table에서 조건 or JOIN으로 써서 user_id, user_username, user_profile_url 을 가져옮\n (user_id는 해당 프로필로 이동하는데 사용)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
